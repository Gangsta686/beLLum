EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Payments (set as Edge Function secrets, NOT in the Expo client)
# Run: supabase secrets set --env-file ./supabase/.env.payments
# ---------------------------------------------------------------------------
# CryptoCloud (RU + СНГ: Visa/MC/Мир, СБП, ЮMoney, QIWI)
# CRYPTOCLOUD_API_KEY=eyJ...your_token
# CRYPTOCLOUD_SHOP_ID=00000000-0000-0000-0000-000000000000
# CRYPTOCLOUD_SECRET=postback_secret_from_shop_settings

# Cryptomus (EU + Global: Visa/MC, SEPA, Apple/Google Pay)
# CRYPTOMUS_MERCHANT=00000000-0000-0000-0000-000000000000
# CRYPTOMUS_API_KEY=payment_api_key_NOT_payout_key

# Where the user is redirected after paying (deep link or web URL)
# PAYMENTS_RETURN_URL=bellum://topup-return
# Optional: override the public base URL of payments-webhook
# PAYMENTS_WEBHOOK_BASE=https://<project-ref>.functions.supabase.co/payments-webhook
